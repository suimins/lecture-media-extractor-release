{
  "manifest_version": 3,
  "name": "Lecture Script · 강의 자동 저장",
  "version": "0.5.1",
  "minimum_chrome_version": "120",
  "description": "크롬에서 MP4 영상, MP3 음성, 스크립트를 선택해 다운로드/lecture/과목명에 저장합니다.",
  "key": "",
  "permissions": ["storage", "tabs", "webRequest", "webNavigation", "cookies", "nativeMessaging", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "강의 자동 저장", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://learn.hansung.ac.kr/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
